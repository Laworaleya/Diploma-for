# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# Get from: MongoDB Atlas → Connect → Drivers → Copy connection string
# Replace <username>, <password>, <cluster> with your actual values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/financial_literacy?retryWrites=true&w=majority&appName=finlit
MONGODB_DB_NAME=financial_literacy

# ── Redis (optional) ───────────────────────────────────────────────────────────
# Leave empty to disable caching. Used only for PDF category cache.
REDIS_URI=

# ── JWT ────────────────────────────────────────────────────────────────────────
# Use a long random string in production. Render can auto-generate this.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_PROMPT_ID=pmpt_...
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_TIMEOUT_SECONDS=45

# ── Telegram Bot ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=FinLit Platform
APP_VERSION=1.0.0
# In production: set to your Render frontend URL (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
